    },
    {
      "id": "GuXRvVywXW8CtX8lerluF",
      "type": "text",
      "x": 540.3624392901163,
      "y": 346.2557999789808,
      "width": 453.6596984863281,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 1402480018,
      "version": 90,
      "versionNonce": 2142125394,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793369665092,
      "link": null,
      "locked": false,
      "text": "Test a few smaller pieces together\noften these are call API, validate DB changed",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Test a few smaller pieces together\noften these are call API, validate DB changed",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NA6jon6kT6UUHWmEczsFY",
      "type": "text",
      "x": 1072.0451367186265,
      "y": 339.1980873489485,
      "width": 405.4797058105469,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 397614414,
      "version": 117,
      "versionNonce": 1347781198,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793369728633,
      "link": null,
      "locked": false,
      "text": "Test the entire stack of your application\noften done through browser automation\n\nThese tend to be brittle",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Test the entire stack of your application\noften done through browser automation\n\nThese tend to be brittle",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uc1pNFp8LCmVU01oWjhL1",
      "type": "text",
      "x": 316.0959382128451,
      "y": 556.5569422013999,
      "width": 63.08396911621094,
      "height": 35,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
