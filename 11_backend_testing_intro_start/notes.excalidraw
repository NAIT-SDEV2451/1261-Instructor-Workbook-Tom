      "versionNonce": 2142125394,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793369665092,
      "link": null,
      "locked": false,
      "text": "Test a few smaller pieces together\noften these are call API, validate DB changed",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Test a few smaller pieces together\noften these are call API, validate DB changed",
      "autoResize": true,
