    {
      "id": "GuXRvVywXW8CtX8lerluF",
      "type": "text",
      "x": 540.3624392901163,
      "y": 346.2557999789808,
      "width": 453.6596984863281,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
