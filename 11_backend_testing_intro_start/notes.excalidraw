      "isDeleted": false,
      "boundElements": null,
      "updated": 1793370376719,
      "link": null,
      "locked": false,
      "text": "Pros",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pros",
      "autoResize": true,
