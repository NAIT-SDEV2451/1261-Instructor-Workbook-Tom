    },
    {
      "id": "e8alTTYoYEIv0wmtXqL5k",
      "type": "text",
      "x": 126.54354157192063,
      "y": 632.681575800082,
      "width": 598.4996337890625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1192176466,
      "version": 408,
      "versionNonce": 2016180494,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793370376719,
      "link": null,
      "locked": false,
      "text": "- can act as validation of the Spec\n(write the test that matches the spec,\nwrite the code that passes the test)\n- I can validate that my new code\ndoesn't change the behaviour of old code\n- Much easier to validate edge cases with automated testing\n- Faster to run automated tests than to do a QA pass\n- Faster debugging, when they fail you know where to look",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- can act as validation of the Spec\n(write the test that matches the spec,\nwrite the code that passes the test)\n- I can validate that my new code\ndoesn't change the behaviour of old code\n- Much easier to validate edge cases with automated testing\n- Faster to run automated tests than to do a QA pass\n- Faster debugging, when they fail you know where to look",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6EoRzsju3p61ukYw-s655",
      "type": "text",
      "x": 1143.9747034928687,
      "y": 545.0908887086928,
      "width": 64.34397888183594,
      "height": 35,
