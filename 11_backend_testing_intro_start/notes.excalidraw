    },
    {
      "id": "HGgO6CHpD2GEwtmRkuiWQ",
      "type": "text",
      "x": 1063.3582655812722,
      "y": 610.010260114568,
      "width": 536.839599609375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1205076494,
      "version": 410,
      "versionNonce": 1932059858,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793370382152,
      "link": null,
      "locked": false,
      "text": "- Must spend the time writing the tests\n- If your tests are garbage, they don't do anything\n- Tests can force you to think about the problem in \na specific way (to solve the test) and limit creativity\n- They don't always work, or are extremely complicated\nto implement for certain problems\n- Most people find them so boring to write\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Must spend the time writing the tests\n- If your tests are garbage, they don't do anything\n- Tests can force you to think about the problem in \na specific way (to solve the test) and limit creativity\n- They don't always work, or are extremely complicated\nto implement for certain problems\n- Most people find them so boring to write\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xaO4yQJ0zHXKuDnWxEMkb",
      "type": "text",
      "x": 465.1875923763983,
      "y": 1103.0184545743182,
      "width": 1335.45947265625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1592215698,
      "version": 288,
      "versionNonce": 1625966350,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793371302451,
      "link": null,
      "locked": false,
      "text": "A- arrange - set up your tests as needed (populate DB with data, setup variables, set up mocks)\nA- act - Do the thing you are trying to test (call function, api call, etc)\nA- assert - Check if it did the right thing (check the db, check the output, side effects)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A- arrange - set up your tests as needed (populate DB with data, setup variables, set up mocks)\nA- act - Do the thing you are trying to test (call function, api call, etc)\nA- assert - Check if it did the right thing (check the db, check the output, side effects)",
      "autoResize": true,
      "lineHeight": 1.25
    },
