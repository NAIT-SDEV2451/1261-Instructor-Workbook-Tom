      "updated": 1792594757008,
      "link": null,
      "locked": false,
      "text": "import { useQuery } from '@tanstack/react-query';\n\nexport function useTodos(status = 'all') {\n  return useQuery({\n    queryKey: ['todos', status],\n    queryFn: () => fetch(`/api/todos?status=${status}`).then((res) => res.json()),\n  });\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import { useQuery } from '@tanstack/react-query';\n\nexport function useTodos(status = 'all') {\n  return useQuery({\n    queryKey: ['todos', status],\n    queryFn: () => fetch(`/api/todos?status=${status}`).then((res) => res.json()),\n  });\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
