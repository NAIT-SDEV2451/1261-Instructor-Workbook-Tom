      "updated": 1788962058920,
      "link": null,
      "locked": false,
      "text": "\n\nPros:\nSupports both front and back end\nit's python\nBunch of useful built in packages\nSuper fast while still being scalable\nDocs are very good\nAccessible to begin\nhigh skill ceiling\n\n\nCons:\nCan be tricky to keep track of\nIt's python\nDoes a lot under the hood so hard to read the code sometimes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nPros:\nSupports both front and back end\nit's python\nBunch of useful built in packages\nSuper fast while still being scalable\nDocs are very good\nAccessible to begin\nhigh skill ceiling\n\n\nCons:\nCan be tricky to keep track of\nIt's python\nDoes a lot under the hood so hard to read the code sometimes",
      "autoResize": true,
      "lineHeight": 1.25
    },
